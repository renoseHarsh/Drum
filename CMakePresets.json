{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_AR": "llvm-ar",
                "CMAKE_RANLIB": "llvm-ranlib",
                "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/Cellar/llvm/23.1.0/lib/c++/libc++.modules.json",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "test",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-test",
            "cacheVariables": {
                "DRUM_TEST_ENABLE": "ON"
            }
        },
        {
          "name": "release",
          "inherits": "default",
          "binaryDir": "${sourceDir}/build-release",
          "cacheVariables": {
              "CMAKE_BUILD_TYPE": "Release",
              "DRUM_BENCHMARK_ENABLE": "ON",
              "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
          }
        }
    ]
}
